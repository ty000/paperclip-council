{
  "name": "@paperclipai/plugin-council",
  "version": "0.7.1",
  "description": "Revisioned Council rosters, durable review decisions, mission admission and integrated candidate verification for Paperclip workflows",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./esbuild.config.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config ./vitest.config.ts",
    "audit:static": "node scripts/ci/run-static-audit.mjs",
    "test:functional": "tsx tests/functional/run.ts",
    "qualification:host:prepare": "node scripts/qualification/paperclip-host.mjs prepare",
    "qualification:host:status": "node scripts/qualification/paperclip-host.mjs status",
    "qualification:host:verify": "node scripts/qualification/paperclip-host.mjs verify",
    "qualification:bounded": "node scripts/qualification/run-bounded.mjs",
    "qualification:native:n2": "node scripts/qualification/run-n2-native-lifecycle.mjs",
    "qualification:preflight:n2": "node scripts/qualification/run-n2-prerequisite.mjs",
    "qualification:live:n1": "node scripts/qualification/run-live-n1.mjs",
    "qualification:live:n2": "node scripts/qualification/run-live-n2.mjs",
    "qualification:live:n2:isolated": "node scripts/qualification/run-live-n2-isolated.mjs",
    "test:receipts": "tsx tests/receipts/run.ts",
    "test:profiles:browser": "tsx tests/receipts/model-profiles-browser.ts",
    "qualification:prepare:n45": "node scripts/qualification/run-n45-campaign.mjs prepare",
    "qualification:ordinary": "node scripts/qualification/run-ordinary-campaign.mjs",
    "qualification:prepare:m2-recovery": "tsx scripts/qualification/prepare-m2-recovery.ts"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.916.1"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.916.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "fallow": "3.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "MIT"
}
