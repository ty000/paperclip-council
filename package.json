{
  "name": "@paperclipai/plugin-council",
  "version": "0.3.0",
  "description": "Revisioned Council rosters, pinned draft missions, and bounded review decisions for Paperclip workflows",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./esbuild.config.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config ./vitest.config.ts",
    "audit:static": "node scripts/ci/run-static-audit.mjs",
    "test:functional": "tsx tests/functional/run.ts",
    "qualification:host:prepare": "node scripts/qualification/paperclip-host.mjs prepare",
    "qualification:host:status": "node scripts/qualification/paperclip-host.mjs status",
    "qualification:host:verify": "node scripts/qualification/paperclip-host.mjs verify",
    "qualification:bounded": "node scripts/qualification/run-bounded.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.916.1"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.916.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "fallow": "3.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "MIT"
}
