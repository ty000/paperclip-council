{
  "name": "@paperclipai/plugin-council",
  "version": "0.2.0",
  "description": "Revisioned Council roster configuration and bounded review decisions for Paperclip workflows",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./esbuild.config.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config ./vitest.config.ts",
    "test:functional": "tsx tests/functional/run.ts"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.916.1"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.916.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "license": "MIT"
}
