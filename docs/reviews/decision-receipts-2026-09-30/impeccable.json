{
  "schema_version": "impeccable-design-gate.v1",
  "wrapper_version": "0.3.0",
  "status": "skipped",
  "mode": "detect-gate",
  "tool": "impeccable",
  "tool_version": null,
  "command": [
    "impeccable",
    "detect",
    "--json",
    "src/ui/decision-receipts.tsx",
    "src/ui/index.tsx"
  ],
  "repo": "/home/davy-lp/workspace/paperclip-council-decision-receipts",
  "targets": [
    "src/ui/decision-receipts.tsx",
    "src/ui/index.tsx"
  ],
  "blocking_findings": [],
  "non_blocking_findings": [
    {
      "rule": "missing-impeccable",
      "message": "Impeccable is not resolvable; run bootstrap explicitly if allowed.",
      "classification": "tooling"
    }
  ],
  "policy": {
    "phase": "lot-4-document-first-design-system",
    "pinned_impeccable_npm_spec": "impeccable@4.0.4",
    "bootstrap": "explicit-only",
    "bootstrap_omit_optional": true,
    "bootstrap_explicit_native_package": true,
    "bootstrap_ignore_scripts": true,
    "pinned_engine_version": "0.1.3",
    "pinned_engine_cli_version": "4.0.0",
    "engine_verification": "pinned SHA-256 and direct native --version",
    "npm_node_requirement": ">=22.18.0",
    "bootstrap_root_must_be_outside_repo": true,
    "missing_impeccable": "skipped",
    "local_file_only_modes": [
      "detect-gate",
      "design-system-seed",
      "design-system-extract",
      "design-system-challenge"
    ],
    "implicit_install_forbidden_modes": [
      "probe",
      "detect-gate",
      "design-context-check",
      "design-system-seed",
      "design-system-extract",
      "design-system-challenge"
    ],
    "subjective_findings_blocking": false,
    "objectivable_blocking_rules": [
      "broken-image",
      "clipped-overflow-container",
      "low-contrast",
      "skipped-heading",
      "text-overflow"
    ],
    "frontend_extensions": [
      ".astro",
      ".css",
      ".htm",
      ".html",
      ".js",
      ".jsx",
      ".less",
      ".mdx",
      ".sass",
      ".scss",
      ".svelte",
      ".ts",
      ".tsx",
      ".vue"
    ],
    "availability_strategies": [
      "IMPECCABLE_BIN",
      "dedicated Codex tool cache with exact impeccable@4.0.4",
      "PATH impeccable binary"
    ],
    "forbidden": [
      "floating package specs such as impeccable@latest",
      "impeccable skills install",
      "impeccable skills update",
      "global skills install/update",
      "URL scans",
      "Puppeteer/browser rendering",
      "live or HMR modes",
      "browser injection",
      "accept/discard flows",
      "source editing through Impeccable",
      "target repo package.json or lockfile modifications"
    ],
    "design_system_assist_modes": [
      "design-system-challenge",
      "design-system-extract",
      "design-system-seed"
    ],
    "design_system_mode_behavior": "document-first handoff generation only; wrapper does not invoke creative Impeccable skill flows or edit source files",
    "impeccable_assisted_commands": {
      "design-system-seed": [
        "/impeccable init",
        "/impeccable document"
      ],
      "design-system-extract": [
        "/impeccable extract"
      ],
      "design-system-challenge": [
        "/impeccable critique",
        "/impeccable polish",
        "/impeccable harden"
      ]
    },
    "lot_4_still_forbidden": [
      "browser-assisted flows",
      "live visual variant mode",
      "automatic source edits by Impeccable",
      "skills install/update"
    ]
  }
}
